# Optional overrides for docker-compose.yaml. Local development needs no .env.
# Copy: cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Never commit .env. Empty values fall back to the dev defaults in docker-compose.yaml.
# Avoid $ quotes @ : / in values (they get interpolated or break the DB URL).

# Linux and the VM: output of `id -u`, set before the first `docker compose up`.
AIRFLOW_UID=
# Host port for the UI and API, always bound to 127.0.0.1.
AIRFLOW_HOST_PORT=

# Required on the VM, set before the first `up` (Postgres and the admin user keep
# their first password until `docker compose down -v`). Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=
# Required on the VM before storing connections. Generate:
# docker compose run --rm --no-deps airflow-scheduler python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
