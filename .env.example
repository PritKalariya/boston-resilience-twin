# Local development only. The VM does not use this file: its secrets come from
# Secret Manager (ADR-015), set up in #20.
# Optional overrides for docker-compose.yaml. Empty values fall back to the dev defaults.
# Copy: cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Never commit .env. Avoid $ quotes @ : / in values (they get interpolated or break the DB URL).

# Linux only: the output of `id -u`, set before the first `docker compose up`,
# so the files Airflow writes to Data-Pipeline/logs stay owned by you.
AIRFLOW_UID=
# Host port for the UI and API, always bound to 127.0.0.1.
AIRFLOW_HOST_PORT=

# Optional local overrides of the dev passwords and keys. Postgres and the admin user
# keep their first password until `docker compose down -v`. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=
# Generate:
# docker compose run --rm --no-deps airflow-scheduler python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
