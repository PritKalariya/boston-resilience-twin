# Test coverage (#38, #112): line coverage of every module in Data-Pipeline/scripts, the
# code the DAG tasks run, and of Model-Development/scripts. A module no test imports still
# counts, at 0%, and nothing is left out. The test service runs it
# (Data-Pipeline/tests/run_tests.sh):
#   python -m pytest Data-Pipeline/tests Model-Development/tests --cov --cov-report=term-missing
# The bar is 70 percent for each folder separately, so one cannot pay for the other.
# run_tests.sh enforces it with `coverage report --include=<folder>/* --fail-under=70`
# (issue #38: 70 percent; the Data-Pipeline suite measured 98.3% on main d5652b9).
# A run with arguments measures Data-Pipeline/scripts alone against the same bar, as before.
[run]
source =
    Data-Pipeline/scripts
    Model-Development/scripts

[report]
show_missing = true
precision = 1
