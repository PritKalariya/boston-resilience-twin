# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
# The provider lock file is kept on purpose so every member resolves the same
# provider versions. Do not ignore it.
!.terraform.lock.hcl

# Secrets and credentials
.env
.env.*
*.env
!.env.example
*-key.json
*credentials*.json
*.pem

# Data (versioned by DVC, never committed)
Data-Pipeline/data/*
!Data-Pipeline/data/.gitkeep

# Training runs (#106): predictions and metrics written per run, never committed
Model-Development/runs/
# Selection reports (#107): written by selection.py and logged to MLflow, never committed
Model-Development/reports/
# Model pipeline artifacts (#112): the default ARTIFACTS_DIR of in_image.sh and model.yml, uploaded by CI, never committed
/artifacts/

# MLflow (#104): the compose server's store (its folder kept by .gitkeep for the mount),
# and local stores, which MLflow names mlruns/, mlartifacts/ or mlflow.db
Model-Development/mlflow/*
!Model-Development/mlflow/.gitkeep
mlruns/
mlartifacts/
mlflow.db

# Airflow logs (bind-mounted into the containers by docker-compose.yaml)
Data-Pipeline/logs/*
!Data-Pipeline/logs/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
*.egg-info/

# Scoping PDF and personal notes (docs/ holds project docs only)
*.pdf

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
